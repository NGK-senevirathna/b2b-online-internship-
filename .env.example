# Copy to .env and replace every value marked CHANGE. Never commit .env.
NODE_ENV=development
PORT=5000
HOST_PORT=5000

# Local PostgreSQL started by docker compose (development only). CHANGE the password.
POSTGRES_PASSWORD=ngk
DATABASE_URL=postgres://postgres:ngk@localhost:5432/b2b_database
DATABASE_SSL=false
DB_POOL_MAX=10

# Generate each with: openssl rand -base64 48   (at least 32 characters, different values)
JWT_SECRET=CHANGE-generate-a-random-secret-of-48-chars-minimum
ROLE_PROVISIONING_KEY=CHANGE-generate-another-random-secret-48-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allowed browser origins. The bundled UI is same-origin, so this is only for other frontends.
CORS_ORIGIN=http://localhost:5000
# Set only when running behind a known reverse proxy (hop count or proxy addresses).
TRUST_PROXY=

# Business rules
TAX_RATE_BPS=0            # tax in basis points, 800 = 8%
LOW_STOCK_THRESHOLD=5     # at or below this quantity a product is "low stock"

# Rate limits per IP: general API per 15 min, failed sign-ins per 15 min, sign-ups per hour
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10

# Optional demo data (npm run db:seed): password for demo accounts. Random if omitted.
# SEED_PASSWORD=
